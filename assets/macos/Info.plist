<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleName</key>
	<string>pain</string>
	<key>CFBundleDisplayName</key>
	<string>pain</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.w-p.pain</string>
	<key>CFBundleExecutable</key>
	<string>pain</string>
	<!-- Named without the .icns extension, per the bundle convention. -->
	<key>CFBundleIconFile</key>
	<string>pain</string>
	<!-- Both replaced with the release version at build time; __VERSION__
	     is substituted by the `macos-bundle` job in the release workflow. -->
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<!-- Without this, macOS runs the app through its 1x scaler and every
	     glyph in the terminal grid renders blurry on a Retina display —
	     the single most important key in this file for a text-heavy app. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Lets a dual-GPU Mac keep using the integrated GPU for this app
	     rather than waking the discrete one just to draw a terminal. -->
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>10.13</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
</dict>
</plist>
